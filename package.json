{
  "name": "penguin-tools",
  "version": "2.5.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "tauri": "tauri",
    "setup": "bun scripts/setup-submodules.ts",
    "build:cli": "bun scripts/build-cli.ts",
    "build:cli:fdd": "bun scripts/build-cli.ts --profile fdd",
    "stage:runtime": "bun scripts/stage-runtime.ts",
    "stage:runtime:fdd": "bun scripts/stage-runtime.ts --profile fdd",
    "stage:runtime:skip": "bun scripts/stage-runtime.ts --skip-publish",
    "stage:runtime:skip:fdd": "bun scripts/stage-runtime.ts --skip-publish --profile fdd",
    "tauri:dev": "bun run stage:runtime && bun scripts/run-tauri.ts dev",
    "tauri:dev:fdd": "bun run stage:runtime:fdd && bun scripts/run-tauri.ts dev",
    "tauri:build": "bun scripts/run-tauri.ts build",
    "bump:version": "bun scripts/bump-version.ts",
    "release": "bun scripts/release.ts",
    "lint": "vp lint",
    "fmt": "vp fmt --write",
    "check": "vp check",
    "prepare": "vp config",
    "doctor": "vp exec react-doctor"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-sans-tc": "^5.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.25",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "~2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.2.0",
    "i18next": "^26.7.1",
    "lucide-react": "^1.66.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.10",
    "react-resizable-panels": "^4.16.0",
    "react-router-dom": "^7.18.5",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react-doctor": "^0.9.21",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  }
}
